{# Campo de formulario estándar.
   Props: name, label, type, value, required, optional, maxlength,
   autocomplete, placeholder, id, input_class, field_class, label_class,
   aria_label, data_focus_key, error, error_class.
   Icono opcional: `icon` (nombre del registro), `wrap_class` e `icon_class`
   para el contenedor relativo y el span del icono; el input recibe `pl-10` por
   defecto para no pisar el glifo. `autofocus` es una decisión de la página.
   `field_class: 'contents'` + `label_class: 'sr-only'` permite integrarlo en
   formularios compactos sin perder el label accesible.
   `error` es el mensaje que ya tradujo Validator (campo => mensaje): cuando
   llega, el input declara `aria-invalid` y ata el mensaje con
   `aria-describedby`, y el <p> con `role="alert"` lo anuncia sin mover el foco
   al mensaje cuando el usuario sigue escribiendo (S4). Sin `error` el campo
   sale exactamente como antes: sin aria de error y sin nodo vacío.
   El <p> del error va FUERA del contenedor del icono: ese div es `relative` y
   `inset-y-0` estira el glifo a todo el alto, así que un párrafo adentro lo
   bajaría del centro del input.
   La pista de opcional sale de `field.optional` en el catálogo: es cromo del
   componente, no texto de la pantalla. #}
{% set input_id = id|default(name) %}
{% set error_message = error|default('') %}
{% set has_icon = icon is defined and icon %}
{% set icon_wrap = wrap_class|default('relative') %}
{% set icon_span = icon_class|default('pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3') %}
{% set default_input = has_icon ? 'input w-full pl-10' : 'input w-full' %}
<fieldset class="{{ field_class|default('fieldset') }}">
    <label class="{{ label_class|default('fieldset-legend') }}" for="{{ input_id }}">
        {{ label }}
        {% if optional|default(false) %}<span class="opacity-60">{{ t('field.optional') }}</span>{% endif %}
    </label>
    {% if has_icon %}<div class="{{ icon_wrap }}">{% endif %}
    {% if has_icon %}
        <span class="{{ icon_span }}" aria-hidden="true">
            {% include 'components/ui/icon.twig' with {name: icon, class: 'h-4 w-4'} %}
        </span>
    {% endif %}
    <input id="{{ input_id }}"
           name="{{ name }}"
           type="{{ type|default('text') }}"
           value="{{ value|default('') }}"
           class="{{ input_class|default(default_input) }}"
           {% if error_message %}aria-invalid="true" aria-describedby="{{ input_id }}-error"{% endif %}
           {% if aria_label is defined %}aria-label="{{ aria_label }}"{% endif %}
           {% if data_focus_key is defined %}data-focus-key="{{ data_focus_key }}"{% endif %}
           {% if required|default(false) %}required{% endif %}
           {% if autofocus|default(false) %}autofocus{% endif %}
           {% if maxlength is defined %}maxlength="{{ maxlength }}"{% endif %}
           {% if autocomplete is defined %}autocomplete="{{ autocomplete }}"{% endif %}
           {% if placeholder is defined %}placeholder="{{ placeholder }}"{% endif %}>
    {% if has_icon %}</div>{% endif %}
    {% if error_message %}
        <p id="{{ input_id }}-error" class="{{ error_class|default('text-error text-sm') }}" role="alert">{{ error_message }}</p>
    {% endif %}
</fieldset>
