{# Sidebar del shell. Recibe `active` y arma el menú desde `navigation_items`,
   que el contenedor compone por convención: Inicio más los archivos de
   config/navigation/. Agregar una entrada es dejar su archivo; no se toca esta
   plantilla.

   `item.label` es una CLAVE del catálogo, no texto: el array se arma una vez por
   proceso y el locale es por request, así que la traducción ocurre acá, en cada
   render. #}

<aside id="sidebar"
       class="fixed inset-y-0 left-0 z-40 flex w-64 flex-col bg-base-100 transition-all duration-200 lg:sticky lg:top-0 lg:bottom-auto lg:h-dvh lg:translate-x-0"
       :class="{ 'translate-x-0': sidebarOpen, '-translate-x-full': !sidebarOpen, 'lg:w-64': !sidebarMini, 'lg:w-16': sidebarMini }"
       x-bind:inert="!sidebarOpen">
    <div class="sidebar-head flex h-16 shrink-0 items-center gap-2 border-b border-base-300 px-4" :class="sidebarMini && 'lg:justify-center lg:px-2'">
        {% include 'components/ui/logo.twig' %}
        <span class="sidebar-label font-bold" :class="sidebarMini && 'lg:hidden'">{{ t('app.name') }}</span>
        <button type="button"
                class="btn btn-square btn-ghost btn-sm ml-auto lg:hidden"
                @click="sidebarOpen = false"
                aria-label="{{ t('layout.close_menu') }}"
                title="{{ t('layout.close_menu') }}">
            {% include 'components/ui/icon.twig' with {name: 'x', class: 'h-5 w-5'} %}
        </button>
    </div>

    <nav class="min-h-0 w-full grow overflow-y-auto" aria-label="{{ t('layout.main_navigation') }}">
        <ul class="menu w-full gap-1 p-2">
            {% for item in navigation_items %}
                {% set is_active = active is defined and active == item.key %}
                {% set item_label = t(item.label) %}
                <li>
                    <a href="{{ url(item.href) }}"
                       class="{% if is_active %}menu-active{% endif %}"
                       title="{{ item_label }}"
                       aria-label="{{ item_label }}"
                       {% if is_active %}aria-current="page"{% endif %}>
                        {% include 'components/ui/icon.twig' with { name: item.icon } %}
                        <span class="sidebar-label" :class="sidebarMini && 'lg:hidden'">{{ item_label }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>

    {% if user_id is defined and user_id %}
        <div class="flex h-12 shrink-0 items-center gap-2 px-2">
            <span class="sidebar-label grid h-8 w-8 shrink-0 place-items-center rounded-full bg-primary text-sm font-bold uppercase text-primary-content"
                  :class="sidebarMini && 'lg:hidden'" aria-hidden="true">{{ user_email|first }}</span>
            <span class="sidebar-label min-w-0 flex-1" :class="sidebarMini && 'lg:hidden'" title="{{ user_email }}">
                <span class="block truncate text-sm font-semibold leading-tight">{{ user_email|split('@')|first|capitalize }}</span>
                <span class="block truncate text-xs leading-tight opacity-60">{{ user_email }}</span>
            </span>
            <form method="post" action="{{ url('/logout') }}" class="shrink-0"
                  :class="sidebarMini && 'lg:mx-auto'">
                {% include 'components/form/csrf.twig' %}
                <button type="submit" class="btn btn-ghost btn-sm btn-square" title="{{ t('layout.logout') }}" aria-label="{{ t('layout.logout') }}">
                    {% include 'components/ui/icon.twig' with {name: 'power', class: 'h-5 w-5'} %}
                </button>
            </form>
        </div>
    {% endif %}
</aside>
