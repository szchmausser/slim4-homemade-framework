<ul class="space-y-2">
    {% for task in tasks %}
        {% if editing_id is defined and editing_id == task.id %}
            <li class="rounded-box border border-base-300 bg-base-100 p-3">
                <form hx-put="/tareas/{{ task.id }}"
                      hx-target="#tareas-panel"
                      hx-swap="outerHTML"
                      class="flex items-center gap-2">
                    {% include 'partials/_csrf.twig' %}
                    {# En fallo de validación se repinta lo TIPEADO (editing_title),
                       no el valor guardado: si no, el usuario pierde lo que
                       escribió junto con el error. Twig autoescapea, así que
                       comillas o <script> tipeados salen neutrales. #}
                    <input type="text"
                           name="title"
                           value="{{ editing_title is defined and editing_title is not null ? editing_title : task.title }}"
                           required
                           maxlength="120"
                           class="input input-bordered input-sm w-full">
                    <button type="submit" class="btn btn-primary btn-sm">
                        Guardar
                    </button>
                    <button type="button"
                            hx-get="/tareas"
                            hx-target="#tareas-panel"
                            hx-swap="outerHTML"
                            class="btn btn-ghost btn-sm">
                        Cancelar
                    </button>
                </form>
            </li>
        {% else %}
            <li class="flex items-center justify-between gap-2 rounded-box border border-base-300 bg-base-100 p-3">
                <span class="flex items-center gap-2 {{ task.status == 'completado' ? 'opacity-80' : '' }}">
                    {# Icono de estado: gris para pendiente, verde para completado #}
                    {% if task.status == 'completado' %}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0 text-success"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                        <span class="text-xs opacity-60">Completada el {{ task.completed_at|date('d/m/Y H:i') }}</span>
                    {% else %}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0 text-base-400"><circle cx="12" cy="12" r="9"/><polyline points="12 12 12 17 16 15"/></svg>
                        <span class="text-xs opacity-60">Pendiente</span>
                    {% endif %}
                    <span class="ml-1">{{ task.title }}</span>
                </span>
                <div class="flex gap-1">
                    {# Botón para cambiar el estado: HTMX intercambia el panel completo #}
                    <button
                        hx-post="/tareas/{{ task.id }}/toggle"
                        hx-target="#tareas-panel"
                        hx-swap="outerHTML"
                        hx-headers="{{ {'csrf_name': csrf_name, 'csrf_value': csrf_value}|json_encode|e('html_attr') }}"
                        class="btn btn-ghost btn-sm {{ task.status == 'completado' ? 'text-success' : '' }}">
                        {{ task.status == 'completado' ? 'Desmarcar' : 'Completar' }}
                    </button>
                    <button
                        hx-get="/tareas/{{ task.id }}/edit"
                        hx-target="#tareas-panel"
                        hx-swap="outerHTML"
                        class="btn btn-ghost btn-sm">
                        Editar
                    </button>
                    <button
                        class="btn btn-ghost btn-sm text-error"
                        @click="$el.closest('li').querySelector('dialog').showModal()">
                        Eliminar
                    </button>
                </div>

            {# Confirmación con modal daisyUI en vez del confirm() nativo:
               - <dialog> es nativo: sin JS de terceros, sin estado Alpine.
               - Se abre por DOM (botón y dialog viven en la misma fila).
               - Cancelar es form method=dialog y afuera es modal-backdrop.
               - En éxito, el swap reemplaza #tareas-panel y el dialog sale
                 del DOM: no hay nada que cerrar a mano.
               - En 400 (CSRF) no hay swap: queda abierto y suena el toast. #}
            <dialog class="modal" aria-label="Confirmar borrado de {{ task.title }}">
                <div class="modal-box">
                    <h3 class="font-bold">¿Borrar esta tarea?</h3>
                    <p class="py-3 opacity-70">{{ task.title }}</p>
                    <div class="modal-action">
                        <form method="dialog">
                            <button class="btn btn-ghost">Cancelar</button>
                        </form>
                        <button
                            hx-delete="/tareas/{{ task.id }}"
                            hx-headers="{{ {'csrf_name': csrf_name, 'csrf_value': csrf_value}|json_encode|e('html_attr') }}"
                            hx-target="#tareas-panel"
                            hx-swap="outerHTML"
                            class="btn btn-error">
                            Borrar
                        </button>
                    </div>
                </div>
                <form method="dialog" class="modal-backdrop">
                    <button>Cerrar</button>
                </form>
            </dialog>
            </li>
        {% endif %}
    {% else %}
        <li class="opacity-60">No hay tareas todavía.</li>
    {% endfor %}
</ul>
