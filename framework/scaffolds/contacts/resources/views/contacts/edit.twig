{% extends 'layouts/app.twig' %}

{% block title %}Editar contacto{% endblock %}

{% block content %}
    <div class="mb-6">
        {% include 'components/ui/button.twig' with {
            label: 'Volver a contactos',
            variant: 'ghost',
            size: 'sm',
            href: url('/contactos'),
            icon: 'arrow-left'
        } only %}
        <h1 class="mt-3 flex items-center gap-2 text-2xl font-bold">
            <span class="opacity-60" aria-hidden="true">
                {% include 'partials/_icon.twig' with {name: 'pencil', class: 'h-5 w-5'} %}
            </span>
            Editar contacto
        </h1>
        <p class="mt-1 text-sm opacity-70">Actualizá los datos y guardá los cambios.</p>
    </div>

    <section class="card border border-base-300 bg-base-100">
        <div class="card-body">
            {% include 'contacts/_form.twig' with {
                action: url('/contactos/' ~ contact.id),
                contact: contact,
                submit_label: 'Guardar cambios',
                submit_icon: 'check'
            } %}
        </div>
    </section>
{% endblock %}
