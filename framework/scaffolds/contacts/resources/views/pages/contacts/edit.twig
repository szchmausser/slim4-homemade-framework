{# Página de edición de un contacto: el formulario completo fuera de un modal.
   La sirve `ContactController::edit()` cuando la petición no trae `HX-Request`,
   y reusa `pages/contacts/_form.twig` con el contacto cargado.

   Para tu entidad copia la página, cambia la acción y la miga de pan. #}
{% extends 'layouts/app.twig' %}

{% block title %}{{ t('contacts.edit_title') }}{% endblock %}

{% block content %}
    <div class="mb-6">
        {% include 'components/ui/button.twig' with {
            label: t('contacts.back'),
            variant: 'ghost',
            size: 'sm',
            href: url('/contacts'),
            icon: 'arrow-left'
        } only %}
        <h1 class="mt-3 flex items-center gap-2 text-2xl font-bold">
            <span class="opacity-60" aria-hidden="true">
                {% include 'components/ui/icon.twig' with {name: 'pencil', class: 'h-5 w-5'} %}
            </span>
            {{ t('contacts.edit_title') }}
        </h1>
        <p class="mt-1 text-sm opacity-70">{{ t('contacts.edit_subtitle') }}</p>
    </div>

    <section class="card border border-base-300 bg-base-100">
        <div class="card-body">
            {# El mismo formulario del alta, ahora con `contact`: al no venir
               `form_values`, los campos salen con lo guardado. #}
            {% include 'pages/contacts/_form.twig' with {
                action: url('/contacts/' ~ contact.id),
                contact: contact,
                submit_label: t('contacts.save_changes'),
                submit_icon: 'check'
            } %}
        </div>
    </section>
{% endblock %}
