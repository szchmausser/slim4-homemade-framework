{# Formulario de contacto: lo comparten el alta, el modal y la página de edición.
   Lo incluyen `pages/contacts/index.twig` y `pages/contacts/edit.twig`, y
   `ContactController::renderForm()` lo devuelve solo en un rechazo de htmx.

   Para tu entidad copia el archivo y cambia los tres campos y la acción.

   `form_values` gana sobre el contacto guardado: en un rechazo se repinta lo que
   el usuario tipeó, no lo que hay en la base. #}
{% set values = form_values|default(contact|default(null)) %}

{# `is_modal` decide el envío: dentro de un modal el formulario viaja por htmx y
   se reemplaza a sí mismo; en la página de edición es un `POST` normal. #}
{% set is_modal = cancel_target is defined and cancel_target %}
<form method="post" action="{{ action }}" class="space-y-4"
      {% if is_modal %}hx-post="{{ action }}" hx-target="this" hx-swap="outerHTML"
      hx-disabled-elt="find button[type='submit']"{% endif %}>
    {% include 'components/form/csrf.twig' %}
    {# `error` va explícito en cada include: los tres usan `only`, así que
       `errors` del contexto no llega solo y el mensaje nunca aparecería. #}
    {% include 'components/form/field.twig' with {
        name: 'name',
        label: 'Nombre',
        type: 'text',
        value: values ? values.name : '',
        required: true,
        maxlength: 120,
        autocomplete: 'name',
        error: errors.name|default(null)
    } only %}
    {% include 'components/form/field.twig' with {
        name: 'email',
        label: 'Email',
        type: 'email',
        value: values ? values.email : '',
        required: true,
        maxlength: 190,
        autocomplete: 'email',
        error: errors.email|default(null)
    } only %}
    {% include 'components/form/field.twig' with {
        name: 'phone',
        label: 'Teléfono',
        type: 'tel',
        value: values ? values.phone : '',
        optional: true,
        maxlength: 50,
        autocomplete: 'tel',
        error: errors.phone|default(null)
    } only %}
    {# Dentro de un modal, Cancelar cierra el diálogo; en la página, vuelve al listado. #}
    <div class="modal-action">
        {% if cancel_target is defined and cancel_target %}
            {% include 'components/ui/button.twig' with {
                label: 'Cancelar',
                variant: 'ghost',
                type: 'button',
                icon: 'x',
                data_modal_close: true
            } only %}
        {% else %}
            {% include 'components/ui/button.twig' with {
                label: 'Cancelar',
                variant: 'ghost',
                href: cancel_href|default(url('/contacts')),
                icon: 'x'
            } only %}
        {% endif %}
        {% include 'components/ui/button.twig' with {
            label: submit_label|default('Guardar'),
            type: 'submit',
            icon: submit_icon|default('check')
        } only %}
    </div>
</form>
