{#
  Panel del listado de Notas: la región que htmx reemplaza.

  Lo incluye `index.twig` en una navegación normal y lo devuelve solo
  `NoteController::renderList()` cuando la petición trae `HX-Request`. Por eso su
  raíz tiene id propio y el paginador apunta a ella.

  Para tu entidad: copia el panel, cambia el contenido de la fila y el `target`
  del paginador.
#}
<div id="notes-panel">
    {# Estado del listado ya validado por `ListQuery`. `estado_sin_orden` deja
       afuera `sort`/`dir` para que los encabezados ordenables los reemplacen;
       `estado_lista` los incluye para el selector de tamaño de página. #}
    {% set estado_sin_orden = {} %}
    {% if list_query.search() is not null %}{% set estado_sin_orden = estado_sin_orden|merge({'q': list_query.search()}) %}{% endif %}
    {% set estado_lista = estado_sin_orden|merge({'sort': list_query.sort(), 'dir': list_query.direction()}) %}

    {# GET puro, sin JS: el formulario reemplaza la query del action, así que el
       orden efectivo viaja en dos hidden y la búsqueda como campo.

       Encima, htmx lo dispara en vivo: `input changed delay:400ms` es el
       debounce nativo (no un timer casero), `change` cubre el caso de un campo
       que confirma al salir y `search` la × del `type="search"`. `hx-push-url`
       mantiene la URL como estado compartible y `hx-target` reemplaza sólo el
       panel.

       `id` + `hx-preserve` son la mitad del patrón: el formulario vive DENTRO de
       la región que se cambia, así que sin `hx-preserve` cada respuesta lo
       reemplazaría y el input perdería el foco y el caret mientras se escribe.
       Con él, htmx deja el nodo que ya está en el DOM. El id tiene que ser único
       en la página: `hx-preserve` se resuelve por id. #}
    <div class="mb-4 flex flex-wrap items-end gap-2">
        <form method="get" action="{{ url('/notes') }}" id="notes-search-form" role="search"
              class="flex flex-wrap items-end gap-2"
              hx-get="{{ url('/notes') }}"
              hx-trigger="input changed delay:400ms, search"
              hx-target="#notes-panel"
              hx-swap="outerHTML"
              hx-push-url="true"
              hx-preserve="true">
            {% if list_query.sort() is not null %}
                <input type="hidden" name="sort" value="{{ list_query.sort() }}">
                <input type="hidden" name="dir" value="{{ list_query.direction() }}">
            {% endif %}
            {% include 'components/form/field.twig' with {
                id: 'note-search',
                name: 'q',
                type: 'search',
                label: t('notes.search_placeholder'),
                value: list_query.search()|default(''),
                placeholder: t('notes.search_placeholder'),
                label_class: 'sr-only',
                field_class: 'contents',
                input_class: 'input w-full sm:w-64'
            } only %}
            {% include 'components/ui/button.twig' with {
                label: t('notes.search'),
                type: 'submit'
            } only %}
        </form>

        {# Limpiar es un enlace normal a la ruta sin estado: navega de verdad, no
           hace un swap, así el input vuelve vacío sin JS extra. Va FUERA del
           formulario a propósito: el formulario se conserva con `hx-preserve`,
           y este control depende de `active()`, que cambia en cada respuesta. #}
        {% if list_query.active() %}
            {% include 'components/ui/button.twig' with {
                label: t('notes.clear'),
                variant: 'ghost',
                href: url('/notes'),
                aria_label: t('notes.clear_aria')
            } only %}
        {% endif %}
    </div>

    {# Encabezados ordenables: la lista es un `<ul>`, así que una fila con
       `role="table"`/`columnheader` es lo que hace válido `aria-sort`. El enlace
       conserva la búsqueda y cambia sólo sort/dir. #}
    <div role="table" aria-label="{{ t('notes.sort_label') }}" class="mb-2">
        <div role="row" class="flex items-center gap-4 text-sm font-semibold">
            {% for columna, datos in {
                'title': {'etiqueta': t('notes.sort_title'), 'defecto': 'asc'},
                'created_at': {'etiqueta': t('notes.sort_created'), 'defecto': 'desc'}
            } %}
                {% set activa = list_query.sort() == columna %}
                {% set siguiente = activa
                    ? (list_query.direction() == 'asc' ? 'desc' : 'asc')
                    : datos.defecto %}
                {% set aria = activa
                    ? (list_query.direction() == 'asc' ? 'ascending' : 'descending')
                    : 'none' %}
                <div role="columnheader" aria-sort="{{ aria }}" class="flex items-center gap-1">
                    <a class="link link-hover" href="{{ (url('/notes') ~ '?' ~ (estado_sin_orden|merge({'sort': columna, 'dir': siguiente})|url_encode))|raw }}">{{ datos.etiqueta }}</a>
                    {% if activa %}
                        {% include 'components/ui/icon.twig' with {
                            name: 'arrow-right',
                            class: 'h-3 w-3 ' ~ (list_query.direction() == 'asc' ? '-rotate-90' : 'rotate-90')
                        } only %}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    {% embed 'components/list/simple.twig' with {
        items: notes,
        empty: t('notes.empty')
    } %}
        {% block row %}
            {# Una fila: el título abre la edición y a la derecha van las dos
               acciones como iconos con nombre accesible. #}
            <li class="flex items-start justify-between gap-3 rounded-box border border-base-300 bg-base-100 p-3">
                <div class="min-w-0">
                    <a class="font-semibold" href="{{ list_query.url(url('/notes/' ~ item.id ~ '/edit')) }}">{{ item.title }}</a>
                    {% if item.body %}
                        <p class="text-sm opacity-70">{{ item.body }}</p>
                    {% endif %}
                </div>
                <div class="flex shrink-0 items-center gap-1">
                    {% include 'components/ui/button.twig' with {
                        label: '',
                        variant: 'ghost',
                        size: 'sm',
                        icon: 'pencil',
                        aria_label: t('notes.edit_aria', {'%title%': item.title}),
                        href: list_query.url(url('/notes/' ~ item.id ~ '/edit'))
                    } only %}

                    {# Borrar no es un POST directo desde la fila: abre el diálogo
                       `note-delete-<id>` que se emite en `after`, así la
                       confirmación es HTML y no un `confirm()` del navegador. #}
                    {% include 'components/ui/button.twig' with {
                        label: '',
                        variant: 'ghost',
                        size: 'sm',
                        icon: 'trash',
                        aria_label: t('notes.delete_aria', {'%title%': item.title}),
                        data_modal_open: 'note-delete-' ~ item.id
                    } only %}
                </div>
            </li>
        {% endblock %}

        {# Los diálogos van en `after`, fuera de la `<ul>`: un `<dialog>` no es
           hijo válido de una lista. Recorren `notes` otra vez porque este bloque
           se emite una vez, sin `item`. #}
        {% block after %}
            {% for item in notes %}
                {% embed 'components/ui/modal.twig' with {
                    id: 'note-delete-' ~ item.id,
                    title: t('notes.delete_title')
                } %}
                    {% block body %}
                        <p class="py-3 opacity-70">{{ t('notes.delete_question', {'%title%': item.title}) }}</p>
                        <form method="post" action="{{ url('/notes/' ~ item.id ~ '/delete') }}"
                              onsubmit="this.querySelector('[type=submit]').disabled = true">
                            {% include 'components/form/csrf.twig' %}
                            <div class="modal-action">
                                {% include 'components/ui/button.twig' with {
                                    label: t('notes.cancel'),
                                    variant: 'ghost',
                                    type: 'button',
                                    icon: 'x',
                                    data_modal_close: true
                                } only %}
                                {% include 'components/ui/button.twig' with {
                                    label: t('notes.delete_confirm'),
                                    variant: 'error',
                                    type: 'submit',
                                    icon: 'trash'
                                } only %}
                            </div>
                        </form>
                    {% endblock %}
                {% endembed %}
            {% endfor %}
        {% endblock %}
    {% endembed %}

    {% include 'components/pagination/simple.twig' with {
        pagination: pagination,
        target: '#notes-panel',
        action: url('/notes'),
        params: estado_lista
    } %}
</div>
