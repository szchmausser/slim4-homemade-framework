{#
  Página del listado de Notas: el shell completo, el modal de alta y, cuando hay
  nota, el de edición.

  La renderiza `NoteController::renderList()`. En una petición htmx ese mismo
  método devuelve sólo `_panel.twig`, que es lo que se reemplaza.

  Para tu entidad: copia la página y cambia textos, modales e `include` del panel.
#}
{% extends 'layouts/app.twig' %}

{% block title %}Notas{% endblock %}

{% block content %}
    <section class="card border border-base-300 bg-base-100">
        <div class="card-body gap-4">
            {% embed 'components/ui/page-header.twig' with {
                icon: 'list',
                title: 'Notas',
                subtitle: 'Tus notas, con alta y acciones por fila.'
            } %}
                {% block actions %}
                    {% embed 'components/ui/action-bar.twig' %}
                        {% block controls %}
                            {% include 'components/ui/button.twig' with {
                                label: 'Agregar nota',
                                icon: 'plus',
                                data_modal_open: 'note-create-modal'
                            } only %}
                        {% endblock %}
                    {% endembed %}
                {% endblock %}
            {% endembed %}

            <h2 class="text-lg font-semibold">Listado</h2>

            {# El `include` y no un `embed`: el panel es la región que el
               controlador devuelve sola en una petición htmx. #}
            {% include 'pages/notes/_panel.twig' %}
        </div>
    </section>

    {% embed 'components/ui/modal.twig' with {
        id: 'note-create-modal',
        title: 'Nueva nota',
        subtitle: 'Pon un título; el cuerpo es opcional.',
        open: open_create_modal|default(false)
    } %}
        {% block body %}
            {# `note: null` corta la herencia del `include`: sin él, en
               /notes/{id}/edit el alta se abriría con los datos de la nota que
               estás editando. #}
            {% include 'pages/notes/_form.twig' with {
                action: url('/notes'),
                submit_label: 'Crear nota',
                submit_icon: 'plus',
                note: null
            } %}
        {% endblock %}
    {% endembed %}

    {# El modal de edición sólo existe si el controlador pasó `note`:
       `renderList()` la manda en `edit` y en el rechazo de `update`, y el
       listado suelto no la trae. #}
    {% if note is defined %}
        {% embed 'components/ui/modal.twig' with {
            id: 'note-edit-modal',
            title: 'Editar nota',
            open: open_edit_modal|default(false)
        } %}
            {% block body %}
                {% include 'pages/notes/_form.twig' with {
                    action: url('/notes/' ~ note.id),
                    submit_label: 'Guardar cambios',
                } %}
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
